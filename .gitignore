# ---- 数据与产物（体积大，一律不进仓库）----
# 用 /data/ 只锚定根目录：写成 data/ 会把 neuralpreset/data/ 整个源码包也忽略掉。
/data/
out/
checkpoints/
runs/
*.zip
*.pth
*.onnx
*.npy
*.npz

# 第三方评测模型的权重是仓库资产，例外放行
!third_party/metric/style_similiary/*.onnx
!third_party/metric/content_similiary/*.pth

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

